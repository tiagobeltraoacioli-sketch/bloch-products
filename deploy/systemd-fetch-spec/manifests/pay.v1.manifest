schema=bloch.products.authenticated-fetch-systemd-spec.v1
artifact=specification-check-only
instance=pay
service-spec=bloch-products-authenticated-fetch-pay.service.spec
user=bloch-pay-fetch
group=bloch-pay-fetch
product-user=bloch-pay
peer-fetch-user=bloch-data-fetch
uid-requirement=dedicated-locked-numeric-host-record
trust-path=/etc/bloch-products/trust/pay
output-path=/run/bloch-products-fetch/pay
credential=transport-policy:/etc/bloch-products/trust/pay/transport-policy
credential=transport-policy-pin:/etc/bloch-products/trust/pay/transport-policy-pin
credential=remote-policy:/etc/bloch-products/trust/pay/remote-policy
credential=remote-policy-pin:/etc/bloch-products/trust/pay/remote-policy-pin
credential=trusted-time-policy:/etc/bloch-products/trust/pay/trusted-time-policy
credential=trusted-time-policy-pin:/etc/bloch-products/trust/pay/trusted-time-policy-pin
credential=external-anchor-policy:/etc/bloch-products/trust/pay/external-anchor-policy
credential=external-anchor-policy-pin:/etc/bloch-products/trust/pay/external-anchor-policy-pin
credential=mtls-client-certificate:/etc/bloch-products/trust/pay/mtls-client-certificate
credential=mtls-client-key-handle:/etc/bloch-products/trust/pay/mtls-client-key-handle
network=online-policy-pinned
private-key-material=external-handle-only
sandbox=fetch-baseline-v1
resources=CPUQuota=20%;MemoryHigh=192M;MemoryMax=384M;TasksMax=24;LimitNOFILE=64;LimitFSIZE=16M;IOWeight=10
