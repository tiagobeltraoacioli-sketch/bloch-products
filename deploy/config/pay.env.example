# Non-secret systemd environment for instance "pay".
BLOCH_PRODUCT_INSTANCE=pay
BLOCH_ADMISSION_PROFILE=synthetic-pilot
BLOCH_STATE_DIR=/var/lib/bloch-products/pay
BLOCH_ROOT_FILE=/etc/bloch-products/roots/pay.root.json
BLOCH_COHABITATION_APPROVAL=/etc/bloch-products/approvals/pay.cohabitation
# Lowercase SHA-256 from the authenticated release record; placeholder fails closed.
BLOCH_CLI_SHA256=REPLACE_WITH_REVIEWED_64_HEX_SHA256
BLOCH_MIN_TOTAL_MEMORY_KIB=6291456
BLOCH_MIN_AVAILABLE_MEMORY_KIB=524288
BLOCH_MIN_AVAILABLE_DISK_KIB=1048576
