# SPECIFICATION/CHECK ARTIFACT ONLY. This is not an installable production unit.
[Unit]
Description=Bloch Data authenticated admission specification (never deploy)
X-Bloch-Artifact=specification-check-only

[Service]
Type=oneshot
User=bloch-data
Group=bloch-data
UMask=0077
LoadCredential=remote-observation:/run/bloch-products-fetch/data/remote-observation
LoadCredential=request-nonce:/run/bloch-products-fetch/data/request-nonce
LoadCredential=fetch-invocation:/run/bloch-products-fetch/data/fetch-invocation
LoadCredential=remote-policy:/etc/bloch-products/trust/data/remote-policy
LoadCredential=remote-policy-pin:/etc/bloch-products/trust/data/remote-policy-pin
LoadCredential=trusted-time-token:/run/bloch-products-fetch/data/trusted-time-token
LoadCredential=trusted-time-request-nonce:/run/bloch-products-fetch/data/trusted-time-request-nonce
LoadCredential=trusted-time-policy:/etc/bloch-products/trust/data/trusted-time-policy
LoadCredential=trusted-time-policy-pin:/etc/bloch-products/trust/data/trusted-time-policy-pin
LoadCredential=checkpoint-artifact:/run/bloch-products-fetch/data/checkpoint-artifact
LoadCredential=checkpoint-policy:/run/bloch-products-fetch/data/checkpoint-policy
LoadCredential=semantic-manifest:/run/bloch-products-fetch/data/semantic-manifest
LoadCredential=lifecycle-policy:/etc/bloch-products/trust/data/lifecycle-policy
LoadCredential=expected-state-identity:/etc/bloch-products/trust/data/expected-state-identity
ExecStart=/usr/bin/false
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/bloch-products/data/state /var/lib/bloch-products/data/cursor /var/lib/bloch-products/data/trusted-time-boundary /run/bloch-products/data/coord
InaccessiblePaths=/etc/bloch-products/trust/data /run/bloch-products-fetch/data /var/lib/bloch-products/pay /run/bloch-products/pay /etc/bloch-products/trust/pay /run/bloch-products-fetch/pay
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
SystemCallArchitectures=native
CPUQuota=25%
MemoryHigh=256M
MemoryMax=512M
TasksMax=32
LimitNOFILE=128
LimitFSIZE=32M
IOWeight=10
OOMPolicy=stop
