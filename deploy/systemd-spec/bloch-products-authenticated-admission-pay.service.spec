# SPECIFICATION/CHECK ARTIFACT ONLY. This is not an installable production unit.
[Unit]
Description=Bloch Pay authenticated admission specification (never deploy)
X-Bloch-Artifact=specification-check-only

[Service]
Type=oneshot
User=bloch-pay
Group=bloch-pay
UMask=0077
LoadCredential=remote-observation:/run/bloch-products-fetch/pay/remote-observation
LoadCredential=request-nonce:/run/bloch-products-fetch/pay/request-nonce
LoadCredential=fetch-invocation:/run/bloch-products-fetch/pay/fetch-invocation
LoadCredential=remote-policy:/etc/bloch-products/trust/pay/remote-policy
LoadCredential=remote-policy-pin:/etc/bloch-products/trust/pay/remote-policy-pin
LoadCredential=trusted-time-token:/run/bloch-products-fetch/pay/trusted-time-token
LoadCredential=trusted-time-request-nonce:/run/bloch-products-fetch/pay/trusted-time-request-nonce
LoadCredential=trusted-time-policy:/etc/bloch-products/trust/pay/trusted-time-policy
LoadCredential=trusted-time-policy-pin:/etc/bloch-products/trust/pay/trusted-time-policy-pin
LoadCredential=checkpoint-artifact:/run/bloch-products-fetch/pay/checkpoint-artifact
LoadCredential=checkpoint-policy:/run/bloch-products-fetch/pay/checkpoint-policy
LoadCredential=semantic-manifest:/run/bloch-products-fetch/pay/semantic-manifest
LoadCredential=expected-state-identity:/etc/bloch-products/trust/pay/expected-state-identity
ExecStart=/usr/bin/false
NoNewPrivileges=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
ReadWritePaths=/var/lib/bloch-products/pay/state /var/lib/bloch-products/pay/cursor /var/lib/bloch-products/pay/trusted-time-boundary /run/bloch-products/pay/coord
InaccessiblePaths=/etc/bloch-products/trust/pay /run/bloch-products-fetch/pay /var/lib/bloch-products/data /run/bloch-products/data /etc/bloch-products/trust/data /run/bloch-products-fetch/data
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
SystemCallArchitectures=native
CPUQuota=25%
MemoryHigh=256M
MemoryMax=512M
TasksMax=32
LimitNOFILE=128
LimitFSIZE=32M
IOWeight=10
OOMPolicy=stop
