schema=bloch.products.authenticated-admission-systemd-spec.v1
artifact=specification-check-only
instance=pay
service-spec=bloch-products-authenticated-admission-pay.service.spec
user=bloch-pay
group=bloch-pay
fetch-user=bloch-pay-fetch
peer-user=bloch-data
uid-requirement=dedicated-locked-numeric-host-record
state-path=/var/lib/bloch-products/pay/state
cursor-path=/var/lib/bloch-products/pay/cursor
trusted-time-boundary-path=/var/lib/bloch-products/pay/trusted-time-boundary
coordination-path=/run/bloch-products/pay/coord
trust-path=/etc/bloch-products/trust/pay
fetch-path=/run/bloch-products-fetch/pay
credential=remote-observation:/run/bloch-products-fetch/pay/remote-observation
credential=request-nonce:/run/bloch-products-fetch/pay/request-nonce
credential=fetch-invocation:/run/bloch-products-fetch/pay/fetch-invocation
credential=remote-policy:/etc/bloch-products/trust/pay/remote-policy
credential=remote-policy-pin:/etc/bloch-products/trust/pay/remote-policy-pin
credential=trusted-time-token:/run/bloch-products-fetch/pay/trusted-time-token
credential=trusted-time-request-nonce:/run/bloch-products-fetch/pay/trusted-time-request-nonce
credential=trusted-time-policy:/etc/bloch-products/trust/pay/trusted-time-policy
credential=trusted-time-policy-pin:/etc/bloch-products/trust/pay/trusted-time-policy-pin
credential=checkpoint-artifact:/run/bloch-products-fetch/pay/checkpoint-artifact
credential=checkpoint-policy:/run/bloch-products-fetch/pay/checkpoint-policy
credential=semantic-manifest:/run/bloch-products-fetch/pay/semantic-manifest
credential=expected-state-identity:/etc/bloch-products/trust/pay/expected-state-identity
network=offline-private
sandbox=baseline-v1
resources=CPUQuota=25%;MemoryHigh=256M;MemoryMax=512M;TasksMax=32;LimitNOFILE=128;LimitFSIZE=32M;IOWeight=10
