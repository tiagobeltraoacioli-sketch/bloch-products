schema=bloch.products.authenticated-admission-systemd-spec.v1
artifact=specification-check-only
instance=data
service-spec=bloch-products-authenticated-admission-data.service.spec
user=bloch-data
group=bloch-data
fetch-user=bloch-data-fetch
peer-user=bloch-pay
uid-requirement=dedicated-locked-numeric-host-record
state-path=/var/lib/bloch-products/data/state
cursor-path=/var/lib/bloch-products/data/cursor
trusted-time-boundary-path=/var/lib/bloch-products/data/trusted-time-boundary
coordination-path=/run/bloch-products/data/coord
trust-path=/etc/bloch-products/trust/data
fetch-path=/run/bloch-products-fetch/data
credential=remote-observation:/run/bloch-products-fetch/data/remote-observation
credential=request-nonce:/run/bloch-products-fetch/data/request-nonce
credential=fetch-invocation:/run/bloch-products-fetch/data/fetch-invocation
credential=remote-policy:/etc/bloch-products/trust/data/remote-policy
credential=remote-policy-pin:/etc/bloch-products/trust/data/remote-policy-pin
credential=trusted-time-token:/run/bloch-products-fetch/data/trusted-time-token
credential=trusted-time-request-nonce:/run/bloch-products-fetch/data/trusted-time-request-nonce
credential=trusted-time-policy:/etc/bloch-products/trust/data/trusted-time-policy
credential=trusted-time-policy-pin:/etc/bloch-products/trust/data/trusted-time-policy-pin
credential=checkpoint-artifact:/run/bloch-products-fetch/data/checkpoint-artifact
credential=checkpoint-policy:/run/bloch-products-fetch/data/checkpoint-policy
credential=semantic-manifest:/run/bloch-products-fetch/data/semantic-manifest
credential=lifecycle-policy:/etc/bloch-products/trust/data/lifecycle-policy
credential=expected-state-identity:/etc/bloch-products/trust/data/expected-state-identity
network=offline-private
sandbox=baseline-v1
resources=CPUQuota=25%;MemoryHigh=256M;MemoryMax=512M;TasksMax=32;LimitNOFILE=128;LimitFSIZE=32M;IOWeight=10
